#load necessary libraries
library(xml2)
library(dplyr)
library(httr)
library(stringr)
library(tibble)
library(quanteda)
#The ordinal_numbers function converts the argument to a number if it was not originally one.
#The function returns nothing if NAs are introduced. The function finds what the remainder would
#be if the function were to be divided by 100. If the last two digits are between 11 and 13, the
#function then assigns then the suffix "th". This accounts for the fact that all numbers in the teens get the
#"th" suffix, but numbers ending in 1, 2, or 3 would normally get other suffixes. Otherwise, the function assigns numbers with the last digit
#one the "st" suffix, numbers with the last digit 2 the "nd" suffix, and numbers with the last digit 3 the "rd" suffix.
#All other numbers are assigned the "th" suffix. The suffixes are attached to the number using the paste0 function. This function
#is necessary for the next section of code.
ordinal_numbers <- function(number) {
number <- as.numeric(number)
if (is.na(number)) {
return(NA_character_)
}
if ((number %% 100) >= 11 && (number %% 100) <= 13) {
suffix <- "th"
}
else if((number %% 10) == 1) {
suffix <- "st"
}
else if((number %% 10) == 2) {
suffix <- "nd"
}
else if((number %% 10) == 3) {
suffix <- "rd"
}
else {
suffix <- "th"
}
return(paste0(number, suffix))
}
#assigns the base url and my search parameters.
#Uses the GET function to submit the API request and stores the output in
#the variable "response"
base_url <- "https://api.oireachtas.ie/v1/debates"
params <-  list( date_start = "2025-01-01",
date_end = "2025-02-28",
chamber = "dail",
limit = 1000
)
response <- GET(base_url, query = params)
#Fetches the results data from within the response it and stores it in a variable named results
results <- httr::content(response)$results
#The sapply function is picking out the URIs within debate records and storing them in a vector named
#debate_uris
debate_uris <- sapply(results, function(x) x$debateRecord$uri)
#The variable speeches_list is assigned to an empty list.
speeches_list <- list()
#The API parameter debate_id is being set to each debate uri, as the for loop is indexing through.
#For each debate uri, query requests are being made from the base url, effectively pulling data for
#each debate and storing it in the variable response. The code looks in the response to find the first
#item in the results list. Within the result, in the "Debate Records" there are links to the debates in
#different formats. The XML files are grabbed (because they are machine-readable). The URI of the XML files
#is assigned to the variable xml. R will leave the loop if xml is null, the loop will skip to the next debate.
#This prevents the loop from crashing. The Get function is used to fetch the xml links, which are read by the
#read_xml function and assigned to the variable debates_report. The xml_ns_strip function strips the default
#namespaces from a documents to clean the debate reports.
for (i in 1:length(debate_uris)) {
response <- GET(base_url, query = list(debate_id = debate_uris[i]))
xml_uri <- content(response)$results[[1]]$debateRecord$formats$xml$uri
if (is.null(xml_uri)) next
debates_reports <- read_xml(content(GET(xml_uri), as = "text"))
debates_reports <- xml_ns_strip(debates_reports)
#It looks at the tag for the href attribute and uses regular expressions
#to look for one or more digits at the end of the string
dail_number <- str_extract(xml_attr(xml_find_first(debates_reports, "//FRBRauthor"), "href"), "\\d+$")
#concatenates the dail_number (which is transformed into an ordinal number using the ordinal_numbers function)
dail_number_ordinal <- paste(ordinal_numbers(dail_number), "Dáil")
#Uses the xml_find_first function to find the date tag within debates_reports. Then retrieves the date attributes as
#a character string, which is assigned to the variable "date"
date <- xml_attr(xml_find_first(debates_reports, "//docDate"), "date")
date <- as.Date(date)
# Extract Volume Number
volume_number <- xml_text(xml_find_first(debates_reports, "//block[@name='volume']//docNumber"))
# Extract the Debate/Report Number within that volume
debate_in_volume <-  xml_text(xml_find_first(debates_reports, "//block[@name='number']//docNumber"))
#finds a list of the information found in the TLC person tag of the document and assigns it to the
#variable tlc_person
tlc_person <- xml_find_all(debates_reports, "//TLCPerson")
#It pulls out people's names from within the showAs attribute and uses the setNames function to assign
#each person's name to their member ID. It pulls out the element identifier (eID) and uses the paste0
#function to put a hashtag in front of it. This ensures that the format will match speech tags in the
#document
id_name_map <- setNames(xml_attr(tlc_person, "showAs"), paste0("#", xml_attr(tlc_person, "eId")))
#Finds all speech tags within the document and assigns them to the object speeches.
speeches <- xml_find_all(debates_reports, "//speech")
text <- sapply(speeches, function(s) {
paste(xml_text(xml_find_all(s, ".//p")), collapse = " ")
})
#Tokens
toks <- tokens(text, remove_punct = TRUE)
ntokens <- ntoken(toks)
ntypes <- ntype(toks)
if (length(speeches) > 0) {
speeches_list[[i]] <- tibble(
dail = dail_number_ordinal,
vol = volume_number,
no = debate_in_volume,
date = date,
speaker = id_name_map[xml_attr(speeches, "by")],
text = text,
ntokens = ntokens,
ntypes = ntypes
)
}
}
#Bind the rows of speeches_list and arranges the result by date
final_table <- bind_rows(speeches_list) %>% arrange(date)
#Results:
#print the first and last 5 rows of the data
head(final_table, 5)
tail(final_table, 5)
#print the dimensionality of the data
print(dim(final_table))
#Print the total number of unique speakers in the dataset
unique_speakers <- unique(final_table$speaker)
length(unique_speakers)
#Print the average number of tokens per speech
print(mean(final_table$ntokens))
#Print the average number of types per speech
print(mean(final_table$ntypes))
print(unique(final_table$date))
unique_dates <- unique(final_table$date)
print(length(unique_dates))
print(debate_uris)
vector <- c()
KS_test <- function(data) {
ECDF <- ecdf(data)
empiricalCDF <- ECDF(data)
D <- max(abs(empiricalCDF - pnorm(data)))
for(i in 1:length(data)) {
vector[i] <- exp((-(2 * i - 1)^2 * pi^2)/(8 * D^2))
}
sum_vector <- sum(vector)
scaling_factor <- sqrt(2*pi)/D
p <- sum_vector * scaling_factor
return(c(D, p)) #Returns a vector with D and p
}
