model_5.2 <- update(model_5.1, . ~ . + zislam)
model_5.3 <- update(model_5.1, . ~ . + zoil_gas_rentPOP)
model_5.4 <- update(model_5.1, . ~ . + zislam + zoil_gas_rentPOP)
