geom_point(aes(x = Oil_Rents, y = Female_Labor, color = "Oil Rents")) +
geom_smooth(aes(x = Oil_Rents, y = Female_Labor, color = "Oil Rents"), method = "lm", se = FALSE) +
geom_point(aes(x = NatRes_Rents, y = Female_Labor, color = "Natural Resource Rents")) +
geom_smooth(aes(x = NatRes_Rents, y = Female_Labor, color = "Natural Resource Rents"), method = "lm", se = FALSE) +
labs(x = "Rents per Capita",
y = "Female Labor Participation",
